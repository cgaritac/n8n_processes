    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst inventory = items.map((item) => item.json.data).flat();\nconst newOrders = $('Aggregate Requests').first().json.data;\n\nfor (const newOrder of newOrders) {\n  const sizeProduct = inventory.find(item => item.Size === newOrder['Shirt size']);\n\n  // No se encuentra el producto por talla\n  if ( !sizeProduct ) continue;\n  \n  if ( !sizeProduct.Stock ) continue;\n\n  // No hay existencias\n  if ( sizeProduct.Stock <= 0) continue;\n\n  // Esto muta el item en el arreglo\n  sizeProduct.Stock--;\n  newOrder.isSuccess = true;  \n}\n\nreturn {\n  inventory: inventory,\n  orders: newOrders,\n}"
      },
