    {
      "parameters": {
        "jsCode": "// Espera un body como:\n// {\n//   \"Nombre completo\": \"Fernando Herrera\",\n//   \"Correo electrónico\": \"fernando.devtalles@gmail.com\",\n//   \"Fecha de inicio\": \"2025-08-19\",\n//   \"Fecha de retorno\": \"2025-08-23\",\n//   \"Comentarios\": \"Nada en especial\"\n// }\n\nconst src = $input.first().json.body;\nconst errors = [];\n\n// Helpers\nconst getStr = (v) => (v ?? '').toString().trim();\nconst isEmail = (v) => /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v);\nconst ISO_DATE_RE = /^\\d{4}-\\d{2}-\\d{2}$/;\nconst parseISODate = (s) => new Date(`${s}T00:00:00Z`); // avoid server TZ issues\n\n// Extract and normalize\nconst fullName     = getStr(src['Full Name']);\nconst email        = getStr(src['Email']).toLowerCase();\nconst startDateStr = getStr(src['Start date']);\nconst endDateStr   = getStr(src['End date']);\nconst comments     = getStr(src['Comments']);\n\n// Validations\nif (!fullName) errors.push('Name is required.');\nif (!email) errors.push('Email is required.');\nelse if (!isEmail(email)) errors.push('Email is invalid.');\n\nif (!startDateStr) errors.push('Start date is required.');\nelse if (!ISO_DATE_RE.test(startDateStr))\n  errors.push('Start date needs to have a format: YYYY-MM-DD.');\n\nif (!endDateStr) errors.push('End date is required.');\nelse if (!ISO_DATE_RE.test(endDateStr))\n  errors.push('End date needs to have a format: YYYY-MM-DD.');\n\n// Date comparison (only if format is valid)\nif (ISO_DATE_RE.test(startDateStr) && ISO_DATE_RE.test(endDateStr)) {\n  const startDate = parseISODate(startDateStr);\n  const endDate   = parseISODate(endDateStr);\n\n  if (Number.isNaN(startDate.valueOf())) errors.push('Invalid Start date.');\n  if (Number.isNaN(endDate.valueOf())) errors.push('Invalid End date.');\n\n  // Must be strictly before\n  if (!Number.isNaN(startDate.valueOf()) && !Number.isNaN(endDate.valueOf()) && !(startDate < endDate)) {\n    errors.push('The Start date needs to be before the End date.');\n  }\n}\n\n// Optional comments\nif (comments && comments.length > 500) {\n  errors.push('The comments can not have more than 500 characters.');\n}\n\n// Response for chaining with Webhook Response\nif (errors.length) {\n  return [\n    {\n      valid: false,\n      status: 400,\n      errors,\n    },\n  ];\n}\n\nreturn [\n  {\n    valid: true,\n    status: 200,\n    data: {\n      fullName,\n      email,\n      startDate: startDateStr,\n      endDate: endDateStr,\n      comments,\n    },\n  },\n];"
      },
