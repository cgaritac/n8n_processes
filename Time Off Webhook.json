      "id": "b49cc6f9-baa8-4e64-b7d2-1eebd85635c1",
      "name": "Webhook - POST - Solicitar vacaciones",
      "webhookId": "YOUR_HTTP_WEBHOOK_ID",
      "credentials": {
        "httpHeaderAuth": {
          "id": "YOUR_HEADER_AUTH_CREDENTIAL_ID",
          "name": "Header Auth Secret"
